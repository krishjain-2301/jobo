# Copy to .env (or just fill these in on the app's Setup tab)

# Gmail: use an App Password - https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# AI writer - only the provider you pick is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPAT_API_KEY=

# Optional job boards for local (non-remote) jobs - both free
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional: JSearch on RapidAPI (Google for Jobs - LinkedIn/Indeed/Glassdoor listings), free tier
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
